  "canonicalization": {
    "encoding": "UTF-8",
    "compact_separators": [",", ":"],
    "separators": {"item": ",", "key_value": ":"},
    "key_order": "recursive_lexical",
    "array_order": "preserved",
    "hash_algorithm": "SHA-256",
    "decimal_grammar": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$; -0, exponent, NaN and Infinity forbidden",
    "positive_price_grammar": "^(?:[1-9][0-9]*(?:\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9])$",
    "nonnegative_volume_grammar": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
    "utc_timestamp_rule": "RFC3339 timestamp with optional fractional seconds and mandatory Z; offsets are not canonical",
    "iana_timezone_rule": "IANA zone name; fixed numeric offsets are forbidden",
    "timeframe_rule": {"unit": ["minute", "hour", "day", "week"], "multiplier": "positive integer"},
    "stable_id_prefixes": {"knowledge_snapshot": "kbs_", "bar": "bar_", "observation": "obv_", "evidence_item": "evi_", "idempotency_key": "idem_", "market_reference": ["bar_", "obv_"]}
  },
  "vocabularies": {
    "artifact_kinds": ["market_snapshot", "analysis_policy", "analysis_request", "market_observation_frame", "knowledge_citation", "knowledge_evidence_package", "normalized_model_request", "normalized_model_response", "model_call_metadata", "pa_analysis_result", "analysis_run_decision_event", "analysis_run_outcome_event", "policy_outcome_matrix"],
    "result_statuses": ["signal", "conditional", "no_trade", "abstain", "error"],
    "actions": ["buy", "sell", "wait", "none"],
    "stances": ["bullish", "bearish", "neutral", "uncertain"],
    "uncertainty_levels": ["low", "medium", "high"],
    "retrieval_statuses": ["hit", "empty", "ambiguous", "snapshot_mismatch"],
    "model_statuses": ["completed", "error", "unsupported"],
    "model_error_codes": ["model_timeout", "rate_limit", "authentication_error", "transport_error", "provider_error", "invalid_model_response", "unsupported_capability", "grounding_failure", "internal_error"],
    "policy_codes": ["invalid_market_data", "insufficient_history", "partial_data", "stale_data", "incomplete_last_bar_excluded", "no_actionable_evidence", "conflicting_evidence", "model_timeout", "invalid_model_response", "grounding_failure"],
    "quality_statuses": ["ok", "partial", "invalid"],
    "quality_codes": ["invalid_market_data", "insufficient_history", "partial_data", "stale_data", "incomplete_last_bar_excluded"],
    "quality_warning_codes": ["partial_data", "stale_data", "incomplete_last_bar_excluded"],
    "uncertainty_codes": ["insufficient_history", "partial_data", "stale_data", "incomplete_last_bar_excluded", "no_actionable_evidence", "conflicting_evidence", "model_timeout", "invalid_model_response", "grounding_failure", "high_uncertainty"],
    "policy_warning_codes": ["incomplete_last_bar_excluded", "partial_data", "stale_data", "conflicting_evidence", "high_uncertainty"],
    "nested_id_prefixes": ["kbs_", "bar_", "obv_", "evi_", "idem_"]
  }
