{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pa-knowledge/chunks-0.1.0.schema.json",
  "title": "PA knowledge source chunks v0.1.0",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "knowledge_base_version", "chunks"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1.0"},
    "knowledge_base_version": {"type": "string", "minLength": 1},
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "chunk_id", "chunk_key", "source_id", "source_file", "source_sha256",
          "page_start", "page_end", "page_range", "title_path", "parent_chunk_id",
          "adjacent_chunk_ids", "source_text", "semantic_boundary", "provenance_status"
        ],
        "properties": {
          "chunk_id": {"type": "string", "minLength": 1},
          "chunk_key": {"type": "string", "minLength": 1},
          "source_id": {"type": "string", "minLength": 1},
          "source_file": {"type": "string", "minLength": 1},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "page_start": {"type": "integer", "minimum": 1},
          "page_end": {"type": "integer", "minimum": 1},
          "page_range": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}], "minItems": 2, "maxItems": 2},
          "title_path": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "parent_chunk_id": {"type": "string"},
          "adjacent_chunk_ids": {"type": "array", "items": {"type": "string"}},
          "source_text": {"type": "string", "minLength": 1},
          "semantic_boundary": {"type": "string", "minLength": 1},
          "provenance_status": {"type": "string", "minLength": 1},
          "related_image_pages": {"type": "array", "items": {"type": "integer", "minimum": 1}}
        }
      }
    }
  }
}
