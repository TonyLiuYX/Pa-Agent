            "definition-zones"
          ]
        },
        {
          "statement": "Inside Bar（子线）是第二根 K 线，其最高价和最低价完全被第一根 K 线的范围所包裹。",
          "declaration_type": "source_assertion",
          "supporting_chunk_keys": [
            "definition-zones"
          ]
        },
        {
          "statement": "将 Mother Bar 的范围从下到上标记为 0 到 1。",
          "declaration_type": "source_assertion",
          "supporting_chunk_keys": [
            "definition-zones"
          ]
