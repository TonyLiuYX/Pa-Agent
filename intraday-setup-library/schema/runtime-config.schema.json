{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Secret-free local research runtime configuration",
  "type": "object",
  "required": [],
  "properties": {
    "mode": {
      "enum": [
        "demo",
        "live",
        "replay"
      ]
    },
    "source_kind": {
      "enum": [
        "unknown",
        "synthetic",
        "real_market"
      ]
    },
    "symbols": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9.-]{1,20}$"
      }
    },
    "include_variants": {
      "type": "boolean"
    },
    "queue_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "checkpoint_events": {
      "type": "integer",
      "minimum": 1
    },
    "checkpoint_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "host": {
      "const": "127.0.0.1"
    },
    "pace_seconds": {
      "type": "number",
      "minimum": 0
    },
    "demo_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 390
    },
    "demo_sessions": {
      "type": "integer",
      "minimum": 1
    },
    "alpaca_history_sessions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 30
    },
    "recognition": {
      "type": "object"
    },
    "paper": {
      "type": "object"
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_seen": {
          "type": "integer",
          "minimum": 1
        },
        "max_transitions": {
          "type": "integer",
          "minimum": 1
        },
        "max_audit": {
          "type": "integer",
          "minimum": 1
        },
        "max_archive": {
          "type": "integer",
          "minimum": 1
        },
        "max_active": {
          "type": "integer",
          "minimum": 1
        },
        "max_stream_events": {
          "type": "integer",
          "minimum": 1
        },
        "max_session_records": {
          "type": "integer",
          "minimum": 1
        },
        "max_symbols": {
          "type": "integer",
          "minimum": 1
        },
        "max_bars": {
          "type": "integer",
          "minimum": 32
        },
        "max_evidence_sources": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "additionalProperties": false
}
