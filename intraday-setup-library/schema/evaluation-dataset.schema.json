{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frozen annotations, complete coverage and split lock",
  "type": "object",
  "required": [
    "dataset_version",
    "dataset_id",
    "created_at",
    "data_sha256",
    "rule_sha256",
    "configuration_sha256",
    "algorithm_sha256",
    "labels_sha256",
    "coverage_sha256",
    "manifest_sha256",
    "labels",
    "coverage",
    "split_lock",
    "source_kinds",
    "market_validation"
  ],
  "properties": {
    "dataset_version": {
      "const": "1.0.0"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "data_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rule_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "configuration_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "algorithm_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "labels_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "coverage_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "setup_id",
          "symbol",
          "venue",
          "direction",
          "positive",
          "start",
          "end",
          "group_id",
          "source_kind",
          "source"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "setup_id": {
            "type": "string",
            "pattern": "^SET-[0-9]{4}$"
          },
          "variant_id": {
            "type": "string",
            "minLength": 1
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "venue": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "type": "integer",
            "enum": [
              -1,
              1
            ]
          },
          "positive": {
            "type": "boolean"
          },
          "start": {
            "type": "string",
            "format": "date-time",
            "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
          },
          "trigger_time": {
            "oneOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
              },
              {
                "type": "null"
              }
            ]
          },
          "group_id": {
            "type": "string",
            "minLength": 1
          },
          "split": {
            "enum": [
              "development",
              "validation",
              "test"
            ]
          },
          "source_kind": {
            "enum": [
              "synthetic",
              "real_market"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "annotator": {
            "type": "string",
            "minLength": 1
          },
          "data_source": {
            "type": "string",
            "minLength": 1
          },
          "rule_version": {
            "type": "string",
            "minLength": 1
          },
          "data_eligible": {
            "type": "boolean"
          },
          "disputed": {
            "type": "boolean"
          },
          "stage_windows": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "candidate": {
                "type": "object",
                "required": [
                  "start",
                  "end"
                ],
                "properties": {
                  "start": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
                  },
                  "end": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
                  }
                },
                "additionalProperties": false
              },
              "formed": {
                "type": "object",
                "required": [
                  "start",
                  "end"
                ],
                "properties": {
                  "start": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
                  },
                  "end": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
                  }
                },
                "additionalProperties": false
              },
              "triggered": {
                "type": "object",
                "required": [
                  "start",
                  "end"
                ],
                "properties": {
                  "start": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
                  },
                  "end": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "review_records": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "coverage_id",
          "setup_id",
          "symbol",
          "venue",
          "source_kind",
          "source",
          "group_id",
          "start",
          "end",
          "complete"
        ],
        "properties": {
          "coverage_id": {
            "type": "string",
            "minLength": 1
          },
          "setup_id": {
            "type": "string",
            "pattern": "^SET-[0-9]{4}$"
          },
          "variant_id": {
            "type": "string",
            "minLength": 1
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "venue": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "type": "integer",
            "enum": [
              -1,
              1
            ]
          },
          "source_kind": {
            "enum": [
              "synthetic",
              "real_market"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "group_id": {
            "type": "string",
            "minLength": 1
          },
          "split": {
            "enum": [
              "development",
              "validation",
              "test"
            ]
          },
          "start": {
            "type": "string",
            "format": "date-time",
            "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
          },
          "complete": {
            "const": true
          },
          "stage": {
            "enum": [
              "candidate",
              "formed",
              "triggered"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "split_lock": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "development",
          "validation",
          "test"
        ]
      }
    },
    "source_kinds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "synthetic",
          "real_market"
        ]
      }
    },
    "market_validation": {
      "const": "not_run"
    }
  },
  "additionalProperties": false
}
