{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Durable journal envelope: original MarketEvent stays unchanged",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "seq",
    "kind",
    "source",
    "event_id",
    "signature",
    "payload",
    "recorded_at",
    "processed"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "enum": [
        "market",
        "backfill",
        "control",
        "clock",
        "source_status",
        "label"
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "event_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "payload": {
      "type": "object"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "processed": {
      "type": "integer",
      "enum": [
        0,
        1
      ]
    }
  },
  "additionalProperties": false
}
