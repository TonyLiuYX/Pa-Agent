      "type": "object",
      "required": [
        "setup_id",
        "variant_id",
        "source_version",
        "source_sha256",
        "rule_version",
        "rule_sha256",
        "algorithm_sha256",
        "execution_version",
        "execution_sha256",
        "execution_model",
        "requirements",
        "scales",
        "directions",
        "enabled",
        "market_validation",
        "performance_scope"
      ],
      "properties": {
        "setup_id": {
          "type": "string",
          "pattern": "^SET-[0-9]{4}$"
        },
        "variant_id": {
          "type": "string",
          "minLength": 1
        },
        "source_version": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rule_version": {
          "type": "string",
          "minLength": 1
        },
        "rule_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "algorithm_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "execution_version": {
          "type": "string",
          "minLength": 1
        },
        "execution_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "execution_model": {
          "enum": [
            "next_quote_experimental",
            "next_bar_proxy_experimental"
          ]
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scales": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "directions": {
          "type": "array",
          "items": {
            "type": "integer",
            "enum": [
              -1,
              1
            ]
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "market_validation": {
          "const": "not_run"
        },
        "performance_scope": {
          "const": "experimental_overlay_not_source_strategy"
        },
        "detection_algorithm_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "detection_configuration_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
