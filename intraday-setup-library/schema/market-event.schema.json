{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical arrival-ordered MarketEvent (semantic validation also required)",
  "type": "object",
  "required": [
    "event_id",
    "symbol",
    "venue",
    "kind",
    "event_time",
    "arrival_time",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "symbol": {
      "type": "string",
      "minLength": 1
    },
    "venue": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "session",
        "bar",
        "trade",
        "quote",
        "depth",
        "news",
        "consensus",
        "status"
      ]
    },
    "event_time": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "arrival_time": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "payload": {
      "type": "object",
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "halted": {
          "type": "boolean"
        },
        "gap": {
          "type": "boolean"
        },
        "clock": {
          "type": "boolean"
        },
        "connected": {
          "type": "boolean"
        },
        "correction": {
          "type": "boolean"
        },
        "stream": {
          "enum": [
            "all",
            "bar",
            "trade",
            "quote",
            "depth",
            "news",
            "consensus"
          ]
        }
      }
    },
    "quality": {
      "enum": [
        "complete",
        "partial",
        "unavailable"
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "bar"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "open",
              "high",
              "low",
              "close",
              "volume",
              "seconds"
            ],
            "properties": {
              "open": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "high": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "low": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "close": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "volume": {
                "type": "number",
                "minimum": 0
              },
              "seconds": {
                "type": "integer",
                "minimum": 1
              },
              "closed": {
                "const": true
              },
              "notional": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "quote"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "bid",
              "ask"
            ],
            "properties": {
              "bid": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "ask": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "trade"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "price",
              "size",
              "side"
            ],
            "properties": {
              "price": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "size": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "side": {
                "enum": [
                  "buy",
                  "sell",
                  "unknown"
                ]
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "session"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "open_time",
              "close_time"
            ],
            "properties": {
              "open_time": {
                "type": "string",
                "format": "date-time",
                "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
              },
              "close_time": {
                "type": "string",
                "format": "date-time",
                "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
              },
              "tick_size": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "additionalProperties": true
          }
        }
      }
    }
  ]
}
